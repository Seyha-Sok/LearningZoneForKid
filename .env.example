# Copy to .env for local backend configuration. .env is ignored by Git.
# Keep database credentials in server variables, never VITE_ variables.
API_HOST=127.0.0.1
API_PORT=3001

DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@127.0.0.1:5432/little_letters
# Generate a random secret of at least 32 characters for each environment.
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET
BETTER_AUTH_URL=http://127.0.0.1:5173
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Add this PC's current LAN website origin to APP_ORIGINS for phone testing.
